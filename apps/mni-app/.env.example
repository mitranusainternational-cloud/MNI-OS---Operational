# ============================================================
# MNI Gudang - Environment Variables
# Copy this file: cp .env.example .env.local
# Fill in your real values from Supabase Dashboard
# ============================================================

# Supabase Project URL (from: Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anon Key - PUBLIC, safe for browser (from: Project Settings → API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App version (optional, shown in UI)
VITE_APP_VERSION=1.0.0
